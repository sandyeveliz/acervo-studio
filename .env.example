# Acervo Studio configuration
# LLM provider settings for chat, utility tasks, and embeddings.

# Main model — chat + extraction via Ollama OpenAI-compatible endpoint
LMSTUDIO_BASE_URL=http://localhost:11434/v1
LMSTUDIO_MODEL=acervo-extractor-v3-Q4_K_M
LMSTUDIO_API_KEY=ollama

# Utility model — topic detection, query planning, compaction
LMSTUDIO_UTILITY_BASE_URL=http://localhost:11434/v1
LMSTUDIO_UTILITY_MODEL=acervo-extractor-v3-Q4_K_M

# Ollama — embeddings (native API)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=qwen3-embedding

# Cloud providers (optional)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

BRAVE_API_KEY=
