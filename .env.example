# Acervo Studio configuration
# LLM provider settings for chat, utility tasks, and embeddings.

# Main model — user-facing chat (Qwen 3.5 9B with thinking)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=unsloth/qwen3.5-9b
LMSTUDIO_API_KEY=lm-studio

# Utility model — topic detection, query planning, compaction (Qwen 2.5 3B)
LMSTUDIO_UTILITY_BASE_URL=http://localhost:1234/v1
LMSTUDIO_UTILITY_MODEL=qwen2.5-3b-instruct

# Ollama — embeddings only (topic detection)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=

# Cloud providers (optional)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

BRAVE_API_KEY=
